# Vendor unit for guildmaster, owned by the guildmaster RPM. Do not edit;
# set options in /etc/sysconfig/guildmaster or use a drop-in
# (systemctl edit guildmaster.service).
[Unit]
Description=Guildmaster machine-wide jobserver on /dev/guild
Documentation=man:guildmaster(8)
# Starting the service loads the cuse kernel module on demand. /dev/cuse only
# becomes usable by the service account once udev has applied
# 70-guildmaster.rules to it, which is also what makes the device unit
# appear. Without CUSE the start job fails on that dependency rather than
# running the daemon.
Wants=modprobe@cuse.service
After=modprobe@cuse.service
Requires=dev-cuse.device
After=dev-cuse.device

[Service]
Type=exec
User=guildmaster
Group=guildmaster
EnvironmentFile=-/etc/sysconfig/guildmaster
ExecStart=/usr/bin/guildmaster $GUILDMASTER_OPTS
# An invalid --tokens value (exit status 2) is an operator error that a
# restart cannot fix.
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=2

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=/dev/cuse rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=none
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
